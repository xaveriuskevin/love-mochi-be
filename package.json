{
  "name": "love-mochi-be",
  "version": "0.1.0",
  "private": true,
  "description": "Love Mochi backend API",
  "packageManager": "bun@1.3.1",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "bun test"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "express": "^5.0.0",
    "pino": "latest",
    "pino-http": "latest",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.2",
    "pino-pretty": "latest",
    "supertest": "latest",
    "tsc-alias": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest"
  }
}
